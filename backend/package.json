{
  "name": "habitly-backend",
  "version": "1.0.0",
  "description": "Express + SQLite (better-sqlite3) backend for the Habitly habit tracker",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node database/seed.js",
    "seed:reset": "node database/seed.js --reset",
    "test": "node --test"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
